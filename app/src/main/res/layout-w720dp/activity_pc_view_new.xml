<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_root"
    tools:ignore="MissingDefaultResource">

    <ImageView
        android:id="@+id/iv_root_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/homeWideContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/homeSidebar"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include layout="@layout/view_home_top_bar" />

            <include
                layout="@layout/view_home_device_card"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="10dp" />

            <include
                layout="@layout/view_home_controller_card"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="10dp" />

            <include
                layout="@layout/view_home_host_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/homeSelectedSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_status_card"
                android:ellipsize="end"
                android:maxLines="2"
                android:padding="13dp"
                android:textColor="@color/home_secondary_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.limelight.ui.home.HomeHostCarouselView
                android:id="@+id/hostCarousel"
                android:layout_width="match_parent"
                android:layout_height="312dp"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="true"
                android:nextFocusUp="@id/axiButton"
                android:overScrollMode="never" />

            <com.limelight.ui.home.HomePageIndicatorView
                android:id="@+id/homePageIndicator"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="15dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
