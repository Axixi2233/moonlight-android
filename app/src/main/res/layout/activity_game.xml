<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Game" >

    <View
        android:id="@+id/backgroundTouchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <com.limelight.ui.StreamView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:focusedByDefault="true"
        android:defaultFocusHighlightEnabled="false">
        <requestFocus />
    </com.limelight.ui.StreamView>

    <!-- Enabled only for the session-local video zoom/view mode. -->
    <com.limelight.ui.video.VideoZoomGestureOverlay
        android:id="@+id/videoZoomGestureOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="false"
        android:visibility="gone" />

<!--    <com.limelight.ui.ApertureViewGroup-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        app:aperture_color1="#5CF950"-->
<!--        android:layout_gravity="center"-->
<!--        android:padding="5dp"-->
<!--        app:aperture_color2="#FC9595"-->
<!--        app:aperture_border_width="10dp"-->
<!--        app:aperture_border_angle="24dp"-->
<!--        app:aperture_duration="6000"-->
<!--        app:aperture_middle_color="#6CD2F8">-->
<!--    </com.limelight.ui.ApertureViewGroup>-->

    <TextView
        android:id="@+id/notificationOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="right"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:gravity="right"
        android:background="#80000000"
        android:preferKeepClear="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/performanceOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false">

        <LinearLayout
            android:id="@+id/performanceOverlayTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/performanceOverlayBig"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="5dp"
                android:layout_gravity="left"
                android:background="@drawable/bg_stream_panel_soft"
                android:orientation="vertical"
                android:padding="14dp"
                android:preferKeepClear="true"
                android:visibility="gone">

                <TextView
                    android:id="@+id/performanceOverlayBigTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="性能信息"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="ifContentScrolls"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/performanceOverlayBigContent"
                        android:layout_width="match_parent"
                        android:layout_height="360dp"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <android.support.v7.widget.AppCompatTextView
                android:id="@+id/performanceOverlayLite"
                tools:text="延迟/解码：109ms/7ms 丢包率：69% FPS：60"
                android:textSize="10sp"
                android:layout_marginTop="4dp"
                android:background="@drawable/ic_hud_bg"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:drawablePadding="2dp"
                tools:drawableLeft="@drawable/icon_axi_wifi"
                android:paddingBottom="4dp"
                android:gravity="center_vertical"
                android:visibility="gone"
                tools:visibility="visible"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/performanceRumble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:padding="4dp"
                android:textSize="13sp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/ic_hud_bg"
                android:preferKeepClear="true"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/performanceOverlayBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical" />
    </FrameLayout>

    <include layout="@layout/view_stream_loading_overlay" />

    <!-- Drawn above stream UI, but empty regions explicitly pass touch through. -->
    <com.limelight.ui.virtualmouse.VirtualMouseOverlay
        android:id="@+id/virtualMouseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="false" />

    <!-- Session-local DS touchpad. The container itself stays non-clickable so empty space
         continues to pass through to the stream and other virtual controls. -->
    <FrameLayout
        android:id="@+id/dsTouchpadPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/dsTouchpadWindow"
            android:layout_width="260dp"
            android:layout_height="150dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="48dp"
            android:preferKeepClear="true">

            <com.limelight.ui.virtualcontroller.DsTouchpadView
                android:id="@+id/dsTouchpadView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/game_menu_ds_touchpad" />

            <ImageView
                android:id="@+id/dsTouchpadDragHandle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_ds_touchpad_drag_handle"
                android:clickable="false"
                android:contentDescription="@string/game_menu_ds_touchpad_drag_handle"
                android:focusable="false"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_axi_game_pad_move" />
        </FrameLayout>
    </FrameLayout>
</merge>
